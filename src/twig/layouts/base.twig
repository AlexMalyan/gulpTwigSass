{# layout.twig #}
<!DOCTYPE html>
<html lang="ru">

	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<meta http-equiv="X-UA-Compatible" content="ie=edge"/>
		<link rel="stylesheet" href="css/style.min.css"/>
		<title>
			{% block title %}
				{{ settings.title }}
			{% endblock %}
		</title>
	</head>

	<body>
		{% block header %}
			{% include "../header/header.twig" %}
			<!--=include header.html -->
		{% endblock %}

		{% block page %}{% endblock %}

		{% block footer %}
			<!--1=include footer.html -->
			{% include "../footer/footer.twig" %}
		{% endblock %}

		{% block modal %}<!--1=include modal-signin.html -->{% endblock %}

		{% block scripts %}
			<script src="js/script.min.js"></script>
		{% endblock %}

		{% block minicart %}
			<!--=include minicart.html -->
		{% endblock %}
	</body>

</html>
