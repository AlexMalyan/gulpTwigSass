<section class="fp section-block">
	<div class="container-xl">
		<header class="header-block">
			<div class="header-block__box">
				<p class="header-block__title">Популярные товары</p>
				<a href="/" class="header-block__title-link">Смотреть все</a>
			</div>
		</header>
		<div class="fp__grid">
			{% for item in pf %}
				<!--=include futures-products_card.html -->
				{% if item.rating == 4 %}
					<article class="card">
						<div class="card__image-box">
							<img class="card__image" src="./{{ item.images[0] }}.jpg" alt=""/>
						</div>
						<div class="card__content">
							<div class="card__title">
								{{ item.name }}

							</div>
							<div class="card__price">
								<span class="card__price-value">{{ item.price }}
								</span>
							</div>
						</div>
						<button class="card__cart-button">В корзину</button>
					</article>
				{% endif %}
			{% endfor %}
		</div>
	</div>
</section>

