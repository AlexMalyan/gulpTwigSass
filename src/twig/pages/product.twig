{% extends "../layouts/base.twig" %}

{% block page %}
	{% set product = products[0] %}
	<div
		class="product">
		<!-- description -->
		{% include "../product-single/_product-card-description.twig" with product %}
		<!-- end description -->
		<div
			class="container-xl product__container-grid">
			<!-- title content -->
			<div class="product__header">
				<div class="product__title-box">
					<h1 class="product__title-box-head">
						{{ product.name }}
					</h1>
					<div class="product__share-box">
						<div class="product__share-icon">
							<span class="icon">
								{% include '../svg/share.svg' %}
							</span>
						</div>

						<ul class="product__share-list">
						
							<li class="product__share-item">
								<a href="whatsapp://send?text=" class="product__share-link">
									<span class="icon  product__share-icon--whatsapp">
										{% include "../svg/wtapp.svg" %}
									</span>
								</a>
							</li>
							<li class="product__share-item">
								<a href="telegram://send?text=" class="product__share-link">
									<span class="icon product__share-icon--tg">
										{% include "../svg/tg.svg" %}

									</span>
								</a>
							</li>
							<li class="product__share-item">
								<a href="vk" class="product__share-link">
									<span class="icon product__share-icon--vk">
										{% include "../svg/vk.svg" %}

									</span>
								</a>
							</li>
						</ul>
					</div>
				</div>
				<!-- =include breadcrumbs.html -->
			</div>
			<!-- end title content -->
			<!-- sidebar -->
			<div class="product__sidebar">
				<div
					class="product__menu">
					<!--=include _product-card-menu.html -->
					{% include "../product-single/_product-card-menu.twig" %}
				</div>
			</div>
			<!-- end sidebar -->
			<!-- wrapper card content -->
			<div
				class="product__main">
				<!-- _product-card-slider.html -->
				<div class="product__main-slider">
					{% set product_img =products[15].images %}

					{% include "../product-single/_product-card-slider.twig"  with	product.images 	%}
				</div>
				<!-- /_product-card-slider.html -->
				<div class="product__main-info">
					<div
						class="product__rows">
						<!-- <div class="product__col-3 product__main-info-rating">raiting</div> -->
						<div class="product__col-3 product__main-info-article">
							Артикул:
							{{ product.features.sku }}


						</div>
						<div class="product__col-3 product__main-info-vendor">
							<img src="./images/vendors/vendor.png" alt="vendor" class="product__main-info-img"/>
						</div>
					</div>
					<div class="product__main-title">
						{{ product.name }}
					</div>
					<button class="product__main-more">Все характеристики</button>

					<div class="product__main-prices">
						<span class="product__main-price-value">
							{{ product.price }}
						</span>
						{# <span class="product__main-price-currency">руб.</span> #}
						/
						<span class="product__main-price-measure">шт</span>
					</div>
					<div class="product__main-quantity product__rows">
						<div class="product__main-stock product__col-2">
							<span class="icon" style="--color: green">
								{% include "../svg/checked.svg" %}
								<!--=include checked.svg -->
							</span>
							<span class="product__main-stock-value">Много на складе</span>
						</div>
						<div class="product__main-cheaper-form product__col-2">
							<span
								class="icon" style="--color: currentColor">
								<!--=include question.svg -->
								{% include "../svg/question.svg" %}

							</span>
							<span class="product__main-cheaper-text">Есть предложение?</span>
						</div>
					</div>
					<!-- buttons -->
					<div class="product__main-buttons">
						<div class="product__rows">
							<div class="product__main-counter product__col-3">
								<span class="product__main-counter-plus" data-action="plus">
									+</span>
								<span class="product__main-counter-minus" data-action="minus">-
								</span>
								<input class="product__main-counter-input" type="text" value="1" data-counter/>
							</div>
							<button class="product__main-addtocart product__col-3">
								В корзину
							</button>
							<button class="product__main-oneclick product__col-3">
								Купить в один клик
							</button>
						</div>
						<!-- end buttons -->
						<div class="product__main-delivery">
							<span
								class="icon" style="--color: grey">
								{% include "../svg/delivery.svg" %}
								<!--=include delivery.svg -->
							</span>
							<div class="product__main-delivery-preview">
								<span class="product__main-delivery-title">Доставка в Липецк</span>
								<div class="product__main-delivery-item">
									<span class="catalog-delivery-preview-item-name">Самовывоз</span>&nbsp;—&nbsp;<span class="catalog-delivery-preview-item-price">бесплатно</span>
								</div>
								<button class="product__main-delivery-info">Подробнее</button>
							</div>
						</div>
						<div class="product__main-share">
							<button class="product__main-share-button">
								<span class="product__main-share-button-text">Поделиться</span>
								<span
									class="icon product__main-share-button-icon">
									<!--=include share.svg -->
									{% include "../svg/share.svg" %}

								</span>
							</button>
							<p class="product__main-share-text">
								Цена действительна только для интернет-магазина и может отличаться от цен в розничных магазинах
							</p>
							<div class="product__main-share-block">
								<ul class="product__main-share-list">
								{% set share = ['wtapp', 'tg', 'vk'] %}
								{% for s in share %}
									<li class="product__main-share-item">
										<a href="" class="product__main-share-link ">
												{% if s == 'wtapp' %}
												<span
												class="icon product__share-icon--whatsapp">
												{% include "../svg/wtapp.svg" %}
													</span>

												{% elseif s == 'tg' %}
												<span
												class="icon product__share-icon--tg">
												{% include "../svg/tg.svg" %}
													</span>
												
												{% else %}
												<span
												class="icon product__share-icon--vk">
												
												{% include "../svg/vk.svg" %}
</span>

												{% endif %}
												<!--=include wtapp.svg -->
											
										</a>
									</li>
								
									
								{% endfor %}
									
								</ul>
							</div>
						</div>
					</div>
				</div>
			</div>
			<!-- end wrapper card content -->

			<!-- footer product card -->

			{% include "../product-single/_product-card-footer.twig" %}
		<!-- =include _product-card-footer.html -->

			<!-- end  footer product card-->
		</div>
		<!-- end wrapper card content -->
		<!--=include _product-card-dialog.html -->
		{% include "../product-single/_product-card-dialog.twig"%}
	</div>
{% endblock %}
