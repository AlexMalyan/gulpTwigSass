<dialog class="buy-one-click">
  <div class="buy-one-click__box">
    <h2 class="buy-one-click__title">Купить в 1 клик</h2>
  </div>
  <!-- form -->
  <form method="dialog" action="" class="buy-one-click__form">

    <div class="buy-one-click__input-group">
      <label class="buy-one-click__label" for="name">Контактное лицо *</label>
      <input class="buy-one-click__input" type="text" id="name" placeholder="Как к вам обращаться?" required>
    </div>

    <div class="buy-one-click__input-group">
      <label class="buy-one-click__label" for="phone">Телефон *</label>
      <input class="buy-one-click__input" type="tel" id="phone" placeholder="Ваш телефон" required>
    </div>
    <div class="buy-one-click__input-group">
      <label class="buy-one-click__label" for="email">E-Mail *</label>
      <input class="buy-one-click__input" type="email" id="email" placeholder="Ваш E-Mail для чеков" required>
    </div>
    <div class="buy-one-click__input-group">
      <input class="buy-one-click__checkbox" type="checkbox" id="remember">
      <label for="remember" class="buy-one-click__label">Я согласен на обработку персональных данных</label>
    </div>
    <p class="buy-one-click__text">* — Обязательные поля</p>
    <div class="buy-one-click__btn-box">
      <button class="buy-one-click__btn-buy" type="submit">Отправить</button>
      <button class="buy-one-click__btn-cancel">Отмена</button>
    </div>

</dialog>
</form>

<!-- end form -->